[Unit]
Description=Lighting Control app
After=network.target
StartLimitIntervalSec=20
StartLimitBurst=5

[Service]
ExecStart=/home/nick/scripts/LightingControl/scripts/launch.sh
WorkingDirectory=/home/nick/scripts/LightingControl
StandardOutput=journal
StandardError=journal
User=nick
EnvironmentFile=/home/nick/.config/op/service-account-token
Environment=PATH=/home/nick/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Only restart on non-zero exit code
Restart=on-failure
# Wait 10 seconds before restarting
RestartSec=10

[Install]
WantedBy=multi-user.target
