# LightingControl development environment variables
APP_ENV=development

# Set the config file to use
APP_CONFIG=configs/development.yaml

# Key to url-authenticate users to the local web viewer app
# WEBAPP_ACCESS_KEY=op://Dev/PowerControllerViewer/PostingKey

# Key to post system state data to the remote PowerControllerViewer app
VIEWER_ACCESS_KEY=op://Dev/LightingControl/ViewerAccessKey

# STMP credentials
SMTP_SERVER=op://Dev/Gmail SMTP/SMTPServer
SMTP_USERNAME=op://Dev/Gmail SMTP/username
SMTP_PASSWORD="op://Dev/Gmail SMTP/password"
SMTP_SEND_TO_EMAIL=op://Dev/Gmail SMTP/SendTo
